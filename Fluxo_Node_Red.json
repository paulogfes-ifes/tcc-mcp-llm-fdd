    {
        "id": "b4e833c1c6785a78",
        "type": "function",
        "z": "b6add49cc5aedfa5",
        "name": "planta",
        "func": "var K = 1.5;\nvar tau = 3; // Tempo de resposta normal\nvar dt = 0.1;\nvar state = context.get('state') || 0;\n\nvar estado = flow.get('estado_planta') || 'normal';\nvar input = parseFloat(msg.CV) || 0;\n\n// --- 1. FALHA NA BOMBA (Degradação Severa) ---\nif (estado === 'bomba') {\n    // A bomba sofre um desgaste mecânico e perde 85% de eficiência.\n    // A CV vai estourar para tentar compensar, mas o PV vai cair lentamente.\n    input = input * 0.15; \n    tau = 8; // Segura a inércia térmica/hidráulica para a queda ser suave\n}\n\n// --- EQUAÇÃO FÍSICA DO TANQUE ---\nstate = state + (K * input - state) * (dt / tau);\n\n// --- 2. VAZAMENTO NO TANQUE ---\nif (estado === 'vazamento') {\n    // Aumentamos o furo! O PID vai precisar de um esforço colossal (+35 na CV)\n    // para conseguir estabilizar o nível novamente.\n    state = state - 1.8; \n}\n\n// Limites físicos para não bugar o PI\nif (state < 0) state = 0;\nif (state > 100) state = 100;\n\ncontext.set('state', state);\n\n// --- 3. FALHA NO SENSOR ---\nif (estado === 'sensor') {\n    msg.PV = 0;\n    msg.payload = 0;\n} else {\n    msg.PV = state;\n    msg.payload = state;\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 630,
        "y": 320,
        "wires": [
            [
                "93e77ac7d76468df",
                "9741cb07979a02bf"
            ]
        ]
    },
